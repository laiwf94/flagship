  "tests": [
    {
      "name": "a listed tester gets beta access through the segment",
      "flag": "beta-access",
      "context": {
        "key": "alice",
        "email": "alice@example.com"
      },
      "expect": {
        "reason": "TARGETING_MATCH",
        "variant": "on",
        "value": true
      }
    },
    {
      "name": "a qa group member is a tester too",
      "flag": "beta-access",
      "context": {
        "key": "quinn",
        "groups": ["qa"],
        "email": "quinn@example.com"
      },
      "expect": {
        "reason": "TARGETING_MATCH",
        "variant": "on",
        "value": true
      }
    },
    {
      "name": "an excluded user outside the company is refused",
      "flag": "beta-access",
      "context": {
        "key": "mallory",
        "email": "mallory@elsewhere.test"
      },
      "expect": {
        "reason": "TARGETING_MATCH",
        "variant": "off",
        "value": false
      }
    },
    {
      "name": "outside Europe pricing is standard",
      "flag": "pricing",
