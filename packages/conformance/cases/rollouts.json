          "rollout": {
            "variants": [
              {
                "variant": "on",
                "weight": 10000
              },
              {
                "variant": "off",
                "weight": 90000
              }
            ]
          }
        },
        "salt": "ten-percent",
        "clientSide": true,
        "version": 1
      },
